{
  "$schema": "https://raw.githubusercontent.com/lebeDEV02/seo-plugin/main/plugins/seo-audit/schema/config.schema.json",
  "site": "https://example.com",
  "keyPages": ["/"],
  "crawl": {
    "maxPages": 300,
    "concurrency": 4,
    "delayMs": 100,
    "exclude": ["/cdn-cgi/*"]
  },
  "browser": {
    "enabled": true,
    "maxPages": 40,
    "perTemplate": 2,
    "expectSelector": null
  },
  "performance": {
    "enabled": true,
    "maxPages": 5,
    "runs": 5
  },
  "searchConsole": {
    "property": null
  },
  "expect": {
    "noindex": []
  },
  "aiCrawlers": {
    "training": "any",
    "search": "allow",
    "user": "allow"
  },
  "llmsTxt": "optional",
  "ignore": []
}
